# Gemini Live (server only)
GEMINI_API_KEY=

# Supabase / Lovable server variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=

# Production auth: keep this true for customer data.
REQUIRE_AUTH=true

# Existing Flavourly WhatsApp operator
OPERATOR_URL=
OPERATOR_API_KEY=
WEBHOOK_SECRET=
# PayFast billing (server only)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Required for live ITN source-IP validation. Comma-separated PayFast source IPs.
PAYFAST_ALLOWED_IPS=
