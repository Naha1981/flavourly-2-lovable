# Required browser configuration (public values only; these are safe to expose to the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co # Required: Supabase project URL used by the browser client.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me # Required: Supabase publishable key; never use a service-role key here.
VITE_SUPABASE_PROJECT_ID=your-project-id # Required by the Lovable Vite configuration if project ID injection is used.

# Required server Supabase configuration.
SUPABASE_URL=https://your-project.supabase.co # Required: same Supabase project URL for server queries.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me # Required for SSR fallback of the public Supabase client.
SUPABASE_SERVICE_ROLE_KEY= # Required secret: admin server client; never commit or expose to browser.
SUPABASE_PROJECT_ID=your-project-id # Optional: project identifier used by platform tooling.

# Server URL, authentication and runtime.
PUBLIC_APP_URL=http://localhost:3000 # Required for callbacks; production must use the exact HTTPS app URL.
REQUIRE_AUTH=true # Required in deployed environments; keep true.
ALLOW_INSECURE_DEMO=false # Optional: only set true for an explicit non-HTTPS local/demo URL; never for a client.
NODE_ENV=development # Managed by runtime; production deployment must set its own production mode.

# PayFast recurring billing (all required before enabling checkout/ITNs).
PAYFAST_MERCHANT_ID= # Required: merchant ID for the selected sandbox/live account.
PAYFAST_MERCHANT_KEY= # Required: merchant key for the selected sandbox/live account.
PAYFAST_PASSPHRASE= # Required: matching PayFast security passphrase; keep secret.
PAYFAST_SANDBOX=true # Required: true only for sandbox; explicitly false for approved live operation.
PAYFAST_ALLOWED_IPS= # Required before PayFast ITNs are accepted: comma-separated verified source IPs for the deployed Cloudflare target.

# NahaLabs WhatsApp operator and inbound webhook.
OPERATOR_URL= # Required for WhatsApp: base URL of the central operator service.
OPERATOR_API_KEY= # Required secret: platform key for the operator.
WEBHOOK_SECRET= # Required secret: HMAC secret shared with the operator webhook sender.

# AI gateway / Gemini Live.
LOVABLE_API_KEY= # Required for reply drafting: server-side Lovable AI gateway key.
GEMINI_API_KEY= # Required for Gemini Live voice sessions.

# Protected scheduler routes: POST with Authorization: Bearer <secret>.
LOVABLE_CRON_SECRET= # Required for cron routes; set identical secret in the scheduler.
LOVABLE_CRON_SECRET_PREVIOUS= # Optional during secret rotation only; remove after all schedulers use the new secret.

# Revenue Employee and optional research providers (only needed when that provider is enabled).
NAHALLM_BASE_URL= # Optional: NahaLLM API base URL.
NAHALLM_APP_KEY= # Optional secret: NahaLLM bearer credential.
NAHALLM_MODEL_ALIAS=balanced # Optional: model alias; default is balanced.
AGENT_REACH_URL= # Optional: Agent Reach endpoint base URL.
AGENT_REACH_API_KEY= # Optional secret: Agent Reach bearer credential.
JEV_URL= # Optional: Jev research service base URL.
JEV_API_KEY= # Optional secret: Jev credential.
JEV_SOCIAL_URL= # Optional: Jev social research base URL.
JEV_SOCIAL_API_KEY= # Optional secret: Jev social credential.
DEMAND_RADAR_URL= # Optional: Demand Radar endpoint base URL.
DEMAND_RADAR_API_KEY= # Optional secret: Demand Radar bearer credential.
CONTENT_OS_URL= # Optional: Content OS endpoint base URL.
CONTENT_OS_API_KEY= # Optional secret: Content OS bearer credential.
VIDEO_ENGINE_URL= # Optional: video engine endpoint base URL.
VIDEO_ENGINE_API_KEY= # Optional secret: video engine credential.
OPENPOST_BASE_URL= # Optional: OpenPost API base URL.
OPENPOST_API_TOKEN= # Optional secret: OpenPost API token.
OPENPOST_WORKSPACE_ID= # Optional: OpenPost workspace identifier.
BRIGHTBEAN_BASE_URL= # Optional: BrightBean API base URL.
BRIGHTBEAN_API_KEY= # Optional secret: BrightBean credential.
MIXPOST_BASE_URL= # Optional: Mixpost API base URL.
MIXPOST_API_KEY= # Optional secret: Mixpost credential.
FLAVOURLY_PROVIDER_TIMEOUT_MS=8000 # Optional: outbound provider timeout in milliseconds; default 8000.

# E2E configuration (browser test package has separate dependencies and is not yet part of root CI).
E2E_BASE_URL=http://127.0.0.1:4173 # Optional: E2E base URL; defaults to the local test server.
E2E_MODEL= # Optional: model alias used by the E2E agent.

FLAVOURLY_CRON_TIME_BUDGET_MS=120000 # Optional: per-invocation wall-clock budget for fleet cron loops; keep below the platform timeout (150s free-plan edge limit).
FLAVOURLY_CRON_MAX_TENANTS_PER_RUN= # Optional: cap tenants processed per cron invocation; unset means no count cap (time budget still applies). Watermarks resume the rest next run.

# Owner failure alerts (all optional; a structured log line is always emitted)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_OWNER_PHONE=
ALERT_WHATSAPP_TENANT_ID=
ALERT_WHATSAPP_ACCOUNT_ID=
ALERT_THROTTLE_SECONDS=300

# Retention sweeps - OPT-IN. Disabled by default; dry-run unless explicitly
# set to false. Each table needs its own window in days. Nothing is
# scheduled by the repo; wiring a schedule is a separate owner decision.
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_WA_MESSAGES_DAYS=
RETENTION_WA_WEBHOOK_EVENTS_DAYS=
RETENTION_OUTBOX_JOBS_DAYS=
RETENTION_BATCH=500
