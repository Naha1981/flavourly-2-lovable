# Supabase browser/client configuration
VITE_SUPABASE_URL="https://mzjfzcsxjpgydomjdtip.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_dqwCIX7zZcrrH7pgifDgpA_2i5AbGqn"
SUPABASE_URL="https://mzjfzcsxjpgydomjdtip.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_dqwCIX7zZcrrH7pgifDgpA_2i5AbGqn"

# Gemini Live (server only)
GEMINI_API_KEY=

# Supabase / Lovable server variables (SUPABASE_URL is set above; do not repeat it empty here)
SUPABASE_SERVICE_ROLE_KEY=
# The public https:// URL of the deployed app (used for PayFast return/notify URLs).
PUBLIC_APP_URL=
# Lovable AI gateway key, used for message triage, reply drafting and guest preferences.
LOVABLE_API_KEY=

# AUTH IS ON BY DEFAULT. Only for local development: set to true to skip login.
# It is ignored whenever PUBLIC_APP_URL starts with https:// or NODE_ENV=production.
ALLOW_INSECURE_DEMO=

# Scheduled jobs (/api/public/cron/*). The same secret must be sent by the scheduler.
# See docs/handover/RUNBOOK.md for the schedule. REQUIRED in production.
LOVABLE_CRON_SECRET=
# Set during secret rotation so both old and new secrets are accepted briefly.
LOVABLE_CRON_SECRET_PREVIOUS=

# Operator alerts (REQUIRED in production, otherwise nobody hears when something breaks).
# Any webhook that accepts a POST: an ntfy.sh topic URL (free), Slack or Discord webhook.
ALERT_WEBHOOK_URL=
# json (Slack/Discord, default) or text (ntfy)
ALERT_WEBHOOK_FORMAT=json
# Alert when this many sends / webhook events fail within an hour.
ALERT_FAILED_SENDS_PER_HOUR=5

# Existing Flavourly WhatsApp operator
OPERATOR_URL=
OPERATOR_API_KEY=
WEBHOOK_SECRET=
# PayFast billing (server only)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# REQUIRED when PAYFAST_SANDBOX is not "true". Without it payment notifications can be forged.
PAYFAST_PASSPHRASE=
# Keep "true" for development. Set to "false" ONLY for live payments.
PAYFAST_SANDBOX=true
# Required for live ITN source-IP validation. Comma-separated IPs and/or CIDR ranges
# (e.g. 197.97.145.144/28). Copy the current list from PayFast's ITN documentation.
PAYFAST_ALLOWED_IPS=

# NahaLabs Revenue Employee provider adapters (server only)
NAHALLM_BASE_URL=
NAHALLM_APP_KEY=
NAHALLM_MODEL_ALIAS=balanced
AGENT_REACH_URL=
AGENT_REACH_API_KEY=
JEV_URL=
JEV_API_KEY=
JEV_SOCIAL_URL=
JEV_SOCIAL_API_KEY=
DEMAND_RADAR_URL=
DEMAND_RADAR_API_KEY=
CONTENT_OS_URL=
CONTENT_OS_API_KEY=
VIDEO_ENGINE_URL=
VIDEO_ENGINE_API_KEY=
OPENPOST_BASE_URL=
OPENPOST_API_TOKEN=
OPENPOST_WORKSPACE_ID=
BRIGHTBEAN_BASE_URL=
BRIGHTBEAN_API_KEY=
MIXPOST_BASE_URL=
MIXPOST_API_KEY=
FLAVOURLY_PROVIDER_TIMEOUT_MS=8000
